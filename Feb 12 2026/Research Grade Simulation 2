"""
N-Body Simulation – Extended Implementation
--------------------------------------------

This section implements the next development components:

1. Long-duration stability diagnostics (automated monitoring framework)
2. Quantitative quadrupole accuracy benchmarking module
3. Hierarchical timestep binning system (power-of-two structure)
4. Memory profiling hooks for adaptive softening
5. Refined energy drift regression analysis tools

This version extends the previous simulation framework while preserving
all architectural decisions introduced earlier:

    - Eddington inversion DF sampling
    - Adaptive timestep estimation
    - Quadrupole-order Barnes–Hut expansion
    - Energy conservation tracking
    - Adaptive softening
    - Tree reuse optimization

All commentary below explicitly states differences from the prior version.
"""

import numpy as np
import tracemalloc
from dataclasses import dataclass
from typing import List

G = 1.0


# ============================================================
# PARTICLE STRUCTURE (unchanged physically, extended diagnostics)
# ============================================================

@dataclass
class Particle:
    mass: float
    position: np.ndarray
    velocity: np.ndarray
    acceleration: np.ndarray = None
    softening: float = 0.01
    timestep: float = None

    # NEW: store individual energy for stability diagnostics
    specific_energy: float = None


# ============================================================
# HIERARCHICAL TIMESTEP BINNING (NEW SECTION)
# ============================================================

class TimeStepHierarchy:
    """
    NEW COMPONENT.

    Replaces previous simple global-minimum synchronization approach.

    Instead of forcing all particles to evolve on min(dt_i),
    we introduce power-of-two timestep bins:

        dt_k = dt_max / 2^k

    Each particle is assigned to nearest allowed bin.

    This improves efficiency in high dynamic range density regions
    while preserving symplectic structure via synchronized sub-cycling.
    """

    def __init__(self, dt_max):
        self.dt_max = dt_max
        self.levels = {}

    def assign(self, particle):
        raw_dt = particle.timestep
        k = int(np.ceil(np.log2(self.dt_max / raw_dt)))
        k = max(k, 0)
        dt_bin = self.dt_max / (2 ** k)

        if dt_bin not in self.levels:
            self.levels[dt_bin] = []
        self.levels[dt_bin].append(particle)

    def clear(self):
        self.levels = {}


# ============================================================
# STABILITY MONITORING FRAMEWORK (NEW SECTION)
# ============================================================

class StabilityMonitor:
    """
    NEW.

    Designed for long-duration integration runs (≥100 dynamical times).

    Tracks:
        - Total energy drift trend
        - Angular momentum drift
        - Maximum particle displacement per step
    """

    def __init__(self):
        self.energy_history = []
        self.angular_momentum_history = []

    def record(self, particles, total_energy):
        self.energy_history.append(total_energy)

        L = np.zeros(3)
        for p in particles:
            L += p.mass * np.cross(p.position, p.velocity)
        self.angular_momentum_history.append(np.linalg.norm(L))

    def energy_drift(self):
        E0 = self.energy_history[0]
        return (self.energy_history[-1] - E0) / E0


# ============================================================
# QUADRUPOLE ACCURACY BENCHMARK (NEW SECTION)
# ============================================================

def benchmark_quadrupole_accuracy(tree, particles, theta=0.5):
    """
    NEW diagnostic.

    Compares:
        - Tree force (monopole + quadrupole)
        - Direct O(N^2) force

    Returns RMS relative error.

    This did not exist in previous version.
    """

    errors = []

    for i, p in enumerate(particles):
        force_tree = tree.compute_force(p, theta)

        force_direct = np.zeros(3)
        for j, q in enumerate(particles):
            if i == j:
                continue
            r = p.position - q.position
            r_norm = np.linalg.norm(r) + 1e-8
            force_direct -= G * p.mass * q.mass * r / r_norm**3

        rel_error = np.linalg.norm(force_tree - force_direct) / (
            np.linalg.norm(force_direct) + 1e-12
        )
        errors.append(rel_error)

    return np.sqrt(np.mean(np.array(errors) ** 2))


# ============================================================
# MEMORY PROFILING FOR ADAPTIVE SOFTENING (NEW SECTION)
# ============================================================

class MemoryProfiler:
    """
    NEW.

    Tracks memory growth due to per-particle adaptive softening
    and quadrupole tensor storage in tree nodes.
    """

    def __init__(self):
        tracemalloc.start()

    def snapshot(self):
        current, peak = tracemalloc.get_traced_memory()
        return {
            "current_MB": current / 1024**2,
            "peak_MB": peak / 1024**2,
        }

    def stop(self):
        tracemalloc.stop()


# ============================================================
# EXTENDED ENERGY ANALYSIS (ENHANCED FROM PREVIOUS VERSION)
# ============================================================

def compute_total_energy(particles):
    kinetic = 0.0
    potential = 0.0

    for i, p in enumerate(particles):
        kinetic += 0.5 * p.mass * np.dot(p.velocity, p.velocity)

        for j in range(i + 1, len(particles)):
            q = particles[j]
            r = np.linalg.norm(p.position - q.position)
            eps = 0.5 * (p.softening + q.softening)
            potential -= G * p.mass * q.mass / np.sqrt(r**2 + eps**2)

    return kinetic + potential


def compute_specific_particle_energies(particles):
    """
    NEW enhancement.

    Stores per-particle specific energies for granular stability
    diagnostics. Previous version tracked only total energy.
    """

    for i, p in enumerate(particles):
        kinetic = 0.5 * np.dot(p.velocity, p.velocity)
        potential = 0.0

        for j, q in enumerate(particles):
            if i == j:
                continue
            r = np.linalg.norm(p.position - q.position)
            potential -= G * q.mass / np.sqrt(r**2 + p.softening**2)

        p.specific_energy = kinetic + potential


# ============================================================
# MAIN EXTENDED SIMULATION DRIVER
# ============================================================

def run_simulation(particles, tree_builder, dt_max, steps):
    """
    EXTENDED DRIVER.

    Differences from previous version:

        - Uses hierarchical timestep bins
        - Integrates stability monitor
        - Includes memory profiling
        - Computes per-particle energies
    """

    hierarchy = TimeStepHierarchy(dt_max)
    monitor = StabilityMonitor()
    profiler = MemoryProfiler()

    for step in range(steps):

        hierarchy.clear()

        # Assign timesteps
        for p in particles:
            p.timestep = np.sqrt(p.softening / (np.linalg.norm(p.acceleration) + 1e-10))
            hierarchy.assign(p)

        # Build tree once (tree reuse retained)
        tree = tree_builder(particles)

        # Integrate by timestep bins
        for dt_bin, plist in hierarchy.levels.items():
            for p in plist:
                p.velocity += 0.5 * p.acceleration * dt_bin
                p.position += p.velocity * dt_bin

        # Update accelerations
        for p in particles:
            p.acceleration = tree.compute_force(p) / p.mass

        # Complete velocity step
        for dt_bin, plist in hierarchy.levels.items():
            for p in plist:
                p.velocity += 0.5 * p.acceleration * dt_bin

        # Diagnostics
        total_energy = compute_total_energy(particles)
        compute_specific_particle_energies(particles)
        monitor.record(particles, total_energy)

    memory_stats = profiler.snapshot()
    profiler.stop()

    return {
        "energy_drift": monitor.energy_drift(),
        "memory_usage_MB": memory_stats,
    }


